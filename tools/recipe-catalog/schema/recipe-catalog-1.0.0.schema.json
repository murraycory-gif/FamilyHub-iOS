{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hubcircle.local/schema/recipe-catalog-1.0.0.schema.json",
  "title": "HUB Circle recipe catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "generatedAt", "contentHash", "source", "recipeCount", "recipes"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "catalogId": {"type": "string"},
    "generatedAt": {"type": "string"},
    "contentHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "source": {"type": "object"},
    "recipeCount": {"type": "integer", "minimum": 0},
    "recipes": {
      "type": "array",
      "items": {"$ref": "#/$defs/recipe"}
    }
  },
  "$defs": {
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "cuisine", "mealType", "servings", "totalTimeMinutes", "totalTimeText",
        "ingredients", "steps", "images", "source", "attributionLine", "dietLabels", "dietCompatible"
      ],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "cuisine": {"type": "string"},
        "mealType": {
          "enum": ["breakfast", "soup", "salad", "snack", "side", "drink", "bread", "dessert", "dinner"]
        },
        "servings": {"type": "string"},
        "totalTimeMinutes": {"type": ["integer", "null"]},
        "totalTimeText": {"type": "string"},
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "quantity", "unit", "item", "note"],
            "properties": {
              "text": {"type": "string"},
              "quantity": {"type": "string"},
              "unit": {"type": "string"},
              "item": {"type": "string"},
              "note": {"type": "string"}
            }
          }
        },
        "steps": {"type": "array", "items": {"type": "string"}},
        "images": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["hostedPath", "width", "height", "bytes", "attribution"],
            "properties": {
              "hostedPath": {"type": "string"},
              "width": {"type": "integer"},
              "height": {"type": "integer"},
              "bytes": {"type": "integer", "maximum": 256000},
              "attribution": {
                "type": "object",
                "required": ["author", "license", "licenseURL", "sourceURL", "commonsFile"],
                "properties": {
                  "author": {"type": "string"},
                  "license": {"type": "string"},
                  "licenseURL": {"type": "string"},
                  "sourceURL": {"type": "string"},
                  "commonsFile": {"type": "string"}
                }
              }
            }
          }
        },
        "source": {
          "type": "object",
          "required": ["pageURL", "pageTitle", "license", "licenseURL", "authorHistoryURL", "changesMade"],
          "properties": {
            "pageURL": {"type": "string"},
            "pageTitle": {"type": "string"},
            "license": {"const": "CC BY-SA 4.0"},
            "licenseURL": {"type": "string"},
            "authorHistoryURL": {"type": "string"},
            "changesMade": {"type": "string"}
          }
        },
        "attributionLine": {"type": "string"},
        "dietLabels": {"type": "array", "items": {"type": "object"}},
        "dietCompatible": {"type": "array", "items": {"type": "string"}},
        "nutrition": {"type": "object"}
      }
    }
  }
}
